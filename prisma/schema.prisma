// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  client
  vendor
  admin
  super_admin
  fulfillment_center

  @@map("user_role")
}

enum CartType {
  direct
  quotation

  @@map("cart_type")
}

enum QuotationStatus {
  pending_vendor
  vendor_offered
  vendor_countered
  client_countered
  client_accepted
  client_rejected
  vendor_rejected
  cancelled
  expired

  @@map("quotation_status")
}

enum QuotationMessageAction {
  request
  offer
  counter
  accept
  reject
  note

  @@map("quotation_message_action")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String   @unique
  password_hash String
  role        UserRole @default(client)
  is_active   Boolean  @default(true)
  refresh_token String?
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  payments    Payment[]

  @@map("users")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  category        String?
  product_type    String?
  specifications  Json     @default("{}")
  attributes      Json     @default("{}")
  approval_status String   @default("pending")
  approval_notes  String?
  created_by_user_id String? @db.Uuid
  is_active       Boolean  @default(false)
  rating          Decimal  @default(0) @db.Decimal(2, 1)
  review_count    Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @db.Timestamptz

  products_images ProductImage[]
  vendorProducts  VendorProduct[]
  variants        ProductVariant[]
  quotationRequests QuotationRequest[]

  @@map("products")
}

model ProductImage {
  id             String   @id @default(uuid()) @db.Uuid
  product_id     String   @db.Uuid
  image_url      String
  is_primary     Boolean  @default(false)
  display_order  Int      @default(0)
  is_approved    Boolean  @default(false)
  approval_status String  @default("pending")
  created_by_user_id String? @db.Uuid
  reviewed_by_user_id String? @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz
  media_type     String?  @default("image")

  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("products_images")
}

model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @unique @db.Uuid
  company_name String
  gst_number  String?  @unique
  gst_certificate_link String?
  business_type String?
  company_website String?
  phone       String?
  alternative_number String?
  designation String?
  business_description String?
  credit_cycle String?
  minimum_commision_percentage Int? @default(0)
  maximum_commision_percentage Int? @default(0)
  rating      Decimal  @default(0) @db.Decimal(2, 1)
  review_count Int     @default(0)
  is_approved Boolean  @default(false)
  is_active   Boolean  @default(true)
  is_blocked  Boolean  @default(false)
  approval_status String @default("pending")
  approval_notes String?
  reconsideration_notes String?
  application_number String? @unique
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  orders      Order[]
  vendorProducts VendorProduct[]
  quotationRequests QuotationRequest[]

  @@map("vendors")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  user_id         String      @db.Uuid
  vendor_id       String      @db.Uuid
  cart_id         String?     @db.Uuid
  status          String      @default("pending")
  payment_status  String?     @default("pending")
  order_type      String      @default("direct")
  total_amount    Decimal     @db.Decimal(12, 2)
  source          String      @default("client")
  order_reference String?
  order_notes     String?
  customer_name   String?
  customer_email  String?
  customer_phone  String?
  created_by_admin_id String?
  address_line    String      @default("")
  city            String      @default("")
  state           String      @default("")
  country         String      @default("")
  pincode         String      @default("000000")
  latitude        String      @default("0")
  langitude       String      @default("0")
  created_at      DateTime    @default(now()) @db.Timestamptz
  updated_at      DateTime    @default(now()) @db.Timestamptz

  vendor          Vendor      @relation(fields: [vendor_id], references: [id])
  quotationRequests QuotationRequest[]

  @@map("orders")
}

model VendorProduct {
  id                 String   @id @default(uuid()) @db.Uuid
  product_id         String   @db.Uuid
  product_variant_id String   @db.Uuid
  vendor_id          String   @db.Uuid
  price              Decimal  @db.Decimal(12, 2)
  moq                Int
  stock_quantity     Int      @default(0)
  quotation_enabled  Boolean  @default(false)
  quotation_min_qty  Int?
  is_active          Boolean  @default(false)
  status             String   @default("waiting")
  gst_percentage     Decimal? @db.Decimal(5, 2) @default(0.00)
  pending_price      Decimal? @db.Decimal(12, 2)
  created_at         DateTime @default(now()) @db.Timestamptz
  updated_at         DateTime @default(now()) @db.Timestamptz

  vendor             Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant            ProductVariant @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, product_variant_id])

  @@map("vendor_products")
}

model ProductVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  product_id          String   @db.Uuid
  sku                 String?
  properties          Json     @default("{}")
  approval_status     String   @default("approved")
  approval_notes      String?
  created_by_user_id  String? @db.Uuid
  reviewed_by_user_id String? @db.Uuid
  reviewed_at         DateTime? @db.Timestamptz
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz

  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  vendorProducts      VendorProduct[]
  quotationRequests   QuotationRequest[]

  @@unique([product_id, properties])
  @@map("product_variants")
}

model Cart {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  cart_type   CartType @default(direct)
  status      String   @default("active")
  total_amount Decimal? @db.Decimal(12, 2)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  @@index([user_id, cart_type])
  @@unique([user_id, cart_type, status])

  @@map("carts")
}

model QuotationRequest {
  id                    String   @id @default(uuid()) @db.Uuid
  user_id               String   @db.Uuid
  vendor_id             String   @db.Uuid
  product_id            String   @db.Uuid
  product_variant_id    String?  @db.Uuid
  requested_quantity    Int
  requested_price       Decimal? @db.Decimal(12, 2)
  status                QuotationStatus @default(pending_vendor)
  request_note          String?
  buyer_city            String?
  buyer_state           String?
  buyer_country         String?
  buyer_pincode         String?
  current_offer_price   Decimal? @db.Decimal(12, 2)
  current_offer_quantity Int?
  current_offer_by      String?
  accepted_price        Decimal? @db.Decimal(12, 2)
  accepted_quantity     Int?
  rejection_reason      String?
  order_id              String?  @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @default(now()) @db.Timestamptz

  vendor        Vendor  @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  order         Order?  @relation(fields: [order_id], references: [id], onDelete: SetNull)
  messages      QuotationMessage[]
  payments      Payment[]

  @@index([vendor_id])
  @@index([user_id])
  @@index([status])

  @@map("quotation_requests")
}

model QuotationMessage {
  id            String   @id @default(uuid()) @db.Uuid
  quotation_id  String   @db.Uuid
  sender_user_id String  @db.Uuid
  sender_role   String
  action        QuotationMessageAction
  offer_price   Decimal? @db.Decimal(12, 2)
  offer_quantity Int?
  note          String?
  reason        String?
  created_at    DateTime @default(now()) @db.Timestamptz

  quotation     QuotationRequest @relation(fields: [quotation_id], references: [id], onDelete: Cascade)

  @@index([quotation_id])

  @@map("quotation_messages")
}

model Payment {
  id                    String   @id @default(uuid()) @db.Uuid
  user_id               String   @db.Uuid
  amount                Decimal  @db.Decimal(12, 2)
  currency              String   @default("INR")
  status                String   @default("pending")
  payment_method        String   @default("razorpay")
  razorpay_order_id     String?  @unique
  razorpay_payment_id   String?
  razorpay_signature    String?
  order_ids             String[] @db.Uuid
  quotation_request_id  String?  @db.Uuid
  split_number          Int      @default(1)
  split_percentage      Decimal? @db.Decimal(5, 2) @default(100.00)
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @default(now()) @db.Timestamptz

  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  quotation_request     QuotationRequest? @relation(fields: [quotation_request_id], references: [id], onDelete: SetNull)

  @@map("payments")
}

model FulfillmentCenter {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String   @unique @db.Uuid
  name              String
  code              String   @unique
  contact_phone     String?
  contact_email     String?
  manager_name      String?
  address           String
  city              String
  state             String
  country           String
  pincode           String
  latitude          Float?
  longitude         Float?
  total_area_sqft   Decimal? @db.Decimal(10, 2)
  capacity_packages Int?
  storage_type      String?
  operating_hours   String?
  status            String   @default("active")
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @default(now()) @db.Timestamptz

  @@map("fulfillment_centers")
}

