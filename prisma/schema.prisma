generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                                   String
  email                                                                  String                       @unique(map: "idx_users_email_unique") @db.Citext
  password_hash                                                          String
  role                                                                   UserRole                     @default(client)
  is_active                                                              Boolean                      @default(true)
  otp                                                                    String?
  refresh_token                                                          String?
  otp_expiry                                                             DateTime?                    @db.Timestamptz(6)
  is_verified                                                            Boolean                      @default(false)
  created_at                                                             DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                                                             DateTime                     @default(now()) @db.Timestamptz(6)
  deletion_requested_at                                                  DateTime?                    @db.Timestamptz(6)
  abandoned_reminder_logs                                                abandoned_reminder_logs[]
  addresses                                                              addresses?
  carts                                                                  Cart[]
  client                                                                 client?
  delivery_agent_kyc                                                     delivery_agent_kyc[]
  delivery_agents                                                        delivery_agents?
  fulfillment_centers                                                    FulfillmentCenter?
  notifications                                                          notifications[]
  order_item_reviews                                                     order_item_reviews[]
  orders                                                                 Order[]
  payments                                                               Payment[]
  product_specification_product_specification_created_by_user_idTousers  product_specification[]      @relation("product_specification_created_by_user_idTousers")
  product_specification_product_specification_reviewed_by_user_idTousers product_specification[]      @relation("product_specification_reviewed_by_user_idTousers")
  product_variants_product_variants_created_by_user_idTousers            ProductVariant[]             @relation("product_variants_created_by_user_idTousers")
  product_variants_product_variants_reviewed_by_user_idTousers           ProductVariant[]             @relation("product_variants_reviewed_by_user_idTousers")
  products_images_products_images_created_by_user_idTousers              ProductImage[]               @relation("products_images_created_by_user_idTousers")
  products_images_products_images_reviewed_by_user_idTousers             ProductImage[]               @relation("products_images_reviewed_by_user_idTousers")
  quotation_documents                                                    quotation_documents[]
  quotation_messages                                                     QuotationMessage[]
  quotation_requests_quotation_requests_admin_user_idTousers             QuotationRequest[]           @relation("quotation_requests_admin_user_idTousers")
  quotation_requests_quotation_requests_user_idTousers                   QuotationRequest[]           @relation("quotation_requests_user_idTousers")
  service_bookings                                                       service_bookings[]
  service_quotation_messages                                             service_quotation_messages[]
  service_quotations                                                     service_quotations[]
  service_reviews                                                        service_reviews[]
  services                                                               services[]
  services_media_services_media_created_by_user_idTousers                services_media[]             @relation("services_media_created_by_user_idTousers")
  services_media_services_media_reviewed_by_user_idTousers               services_media[]             @relation("services_media_reviewed_by_user_idTousers")
  vendor_chat_messages                                                   vendor_chat_messages[]
  vendor_quotations_vendor_quotations_created_by_admin_idTousers         vendor_quotations[]          @relation("vendor_quotations_created_by_admin_idTousers")
  vendor_quotations_vendor_quotations_reviewed_by_admin_idTousers        vendor_quotations[]          @relation("vendor_quotations_reviewed_by_admin_idTousers")
  vendor_reviews                                                         vendor_reviews[]
  vendors                                                                Vendor?
  wishlists                                                              wishlists?
  employee_candidates_registered                                         employee_candidates[]        @relation("employee_candidates_registered_by")
  employee_candidates_verified                                           employee_candidates[]        @relation("employee_candidates_verified_by")
  employee_documents_uploaded                                            employee_documents[]         @relation("employee_documents_uploaded_by")
  hire_requests_requested                                                hire_requests[]              @relation("hire_requests_requested_by")
  hire_requests_reviewed                                                 hire_requests[]              @relation("hire_requests_reviewed_by")
  client_assets                                                          client_assets[]
  service_tickets_client                                                 service_tickets[]            @relation("service_tickets_client")
  service_tickets_agent                                                  service_tickets[]            @relation("service_tickets_agent")
  service_ticket_documents_uploaded                                      service_ticket_documents[]   @relation("service_ticket_documents_uploaded_by")

  @@map("users")
}

model Product {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                           String
  description                    String?
  category                       String?                 @db.Uuid
  product_type                   String?
  approval_status                String                  @default("pending")
  approval_notes                 String?
  created_by_user_id             String?                 @db.Uuid
  is_active                      Boolean                 @default(false)
  rating                         Decimal                 @default(0) @db.Decimal(2, 1)
  review_count                   Int                     @default(0)
  created_at                     DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                @default(now()) @db.Timestamptz(6)
  quotation_limit                Int?
  vendor_can_set_quotation_limit Boolean                 @default(false)
  item_code                      String?
  attributes                     Json                    @default("{}")
  specifications                 Json                    @default("{}")
  subcategory_id                 String?                 @db.Uuid
  cart_items                     cart_items[]
  order_item_reviews             order_item_reviews[]
  order_items                    order_items[]
  product_specification          product_specification[]
  variants                       ProductVariant[]
  product_category               product_category?       @relation(fields: [category], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_category")
  subcategories                  subcategories?          @relation(fields: [subcategory_id], references: [id], onUpdate: NoAction, map: "fk_products_subcategory")
  products_images                ProductImage[]
  quotation_documents            quotation_documents[]
  quotationRequests              QuotationRequest[]
  vendorProducts                 VendorProduct[]
  vendor_quotations              vendor_quotations[]
  wishlist_items                 wishlist_items[]

  @@index([category], map: "idx_products_category")
  @@index([subcategory_id], map: "idx_products_subcategory_id")
  @@index([product_type], map: "idx_products_product_type")
  @@map("products")
}

model ProductImage {
  id                                               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id                                       String          @db.Uuid
  image_url                                        String
  is_primary                                       Boolean         @default(false)
  display_order                                    Int             @default(0)
  is_approved                                      Boolean         @default(false)
  approval_status                                  String          @default("pending")
  created_by_user_id                               String?         @db.Uuid
  reviewed_by_user_id                              String?         @db.Uuid
  created_at                                       DateTime        @default(now()) @db.Timestamptz(6)
  media_type                                       String?         @default("image")
  product_variant_id                               String?         @db.Uuid
  users_products_images_created_by_user_idTousers  User?           @relation("products_images_created_by_user_idTousers", fields: [created_by_user_id], references: [id], onUpdate: NoAction, map: "fk_products_images_created_by")
  product                                          Product         @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_products_images_product")
  product_variants                                 ProductVariant? @relation(fields: [product_variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_products_images_product_variant")
  users_products_images_reviewed_by_user_idTousers User?           @relation("products_images_reviewed_by_user_idTousers", fields: [reviewed_by_user_id], references: [id], onUpdate: NoAction, map: "fk_products_images_reviewed_by")

  @@index([product_id], map: "idx_products_images_product_id")
  @@index([product_variant_id], map: "idx_products_images_variant_id")
  @@map("products_images")
}

model Vendor {
  id                           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                      String                 @unique(map: "idx_vendors_user_id_unique") @db.Uuid
  company_name                 String
  gst_number                   String?                @unique(map: "idx_vendors_gst_number_unique", where: raw("(gst_number IS NOT NULL)"))
  gst_certificate_link         String?
  business_type                String?
  company_website              String?
  phone                        String?
  alternative_number           String?
  designation                  String?
  business_description         String?
  credit_cycle                 String?
  minimum_commision_percentage Int?                   @default(0)
  maximum_commision_percentage Int?                   @default(0)
  rating                       Decimal                @default(0) @db.Decimal(2, 1)
  review_count                 Int                    @default(0)
  is_approved                  Boolean                @default(false)
  is_active                    Boolean                @default(true)
  is_blocked                   Boolean                @default(false)
  approval_status              vendor_approval_status @default(pending)
  approval_notes               String?
  created_at                   DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime               @default(now()) @db.Timestamptz(6)
  application_number           String?                @unique
  reconsideration_notes        String?
  vendor_signature_image_link  String?
  vendor_type                  String                 @default("product")
  cart_items                   cart_items[]
  order_item_reviews           order_item_reviews[]
  order_items                  order_items[]
  orders                       Order[]
  quotationRequests            QuotationRequest[]
  service_bookings             service_bookings[]
  service_cart_items           service_cart_items[]
  service_quotations           service_quotations[]
  service_reviews              service_reviews[]
  vendor_categories            vendor_categories[]
  vendor_chat_messages         vendor_chat_messages[]
  vendor_payouts               vendor_payouts[]
  vendorProducts               VendorProduct[]
  vendor_quotations            vendor_quotations[]
  vendor_reviews               vendor_reviews[]
  vendor_services              vendor_services[]
  service_tickets              service_tickets[]
  service_ticket_quotations    service_ticket_quotations[]
  users                        User                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vendors_user")
  wishlist_items               wishlist_items[]

  @@index([rating(sort: Desc)], map: "idx_vendors_rating", where: raw("(is_active = true)"))
  @@map("vendors")
}

model Order {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                    String                       @db.Uuid
  vendor_id                  String                       @db.Uuid
  cart_id                    String?                      @db.Uuid
  status                     String                       @default("pending")
  payment_status             String?                      @default("pending")
  total_amount               Decimal                      @db.Decimal(12, 2)
  source                     String                       @default("client")
  order_reference            String?
  order_notes                String?
  customer_name              String?
  customer_email             String?
  customer_phone             String?
  created_by_admin_id        String?
  address_line               String
  city                       String
  state                      String
  country                    String
  pincode                    String                       @db.VarChar(6)
  latitude                   String
  langitude                  String
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  order_type                 String                       @default("direct")
  vendor_city                String?
  vendor_state               String?
  vendor_latitude            Float?
  vendor_longitude           Float?
  pickup_otp                 String?                      @db.VarChar(6)
  pickup_qr_token            String?                      @db.VarChar(255)
  delivery_otp               String?                      @db.VarChar(6)
  delivery_qr_token          String?                      @db.VarChar(255)
  order_fulfillment_tracking order_fulfillment_tracking[]
  order_item_reviews         order_item_reviews[]
  order_items                order_items[]
  order_route_plan           order_route_plan[]
  order_status_history       order_status_history[]
  carts                      Cart?                        @relation(fields: [cart_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_cart")
  users                      User                         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_user")
  vendor                     Vendor                       @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_vendor")
  quotationRequests          QuotationRequest[]
  rider_earnings             rider_earnings[]
  vendor_payouts             vendor_payouts?
  vendor_reviews             vendor_reviews[]

  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user_id")
  @@index([vendor_id], map: "idx_orders_vendor_id")
  @@map("orders")
}

model VendorProduct {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id           String                @db.Uuid
  vendor_id            String                @db.Uuid
  price                Decimal               @db.Decimal(12, 2)
  moq                  Int
  stock_quantity       Int                   @default(0)
  commision_percentage Int?                  @default(0)
  is_active            Boolean               @default(false)
  status               vendor_product_status @default(waiting)
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @default(now()) @db.Timestamptz(6)
  quotation_enabled    Boolean               @default(false)
  quotation_min_qty    Int?
  gst_percentage       Decimal?              @default(0.00) @db.Decimal(5, 2)
  pending_price        Decimal?              @db.Decimal(12, 2)
  product_variant_id   String                @db.Uuid
  discounted_price     Decimal?              @db.Decimal(12, 2)
  product              Product               @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vendor_products_product")
  variant              ProductVariant        @relation(fields: [product_variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vendor_products_variant")
  vendor               Vendor                @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vendor_products_vendor")

  @@unique([vendor_id, product_variant_id], map: "unique_vendor_product_variant")
  @@index([product_id], map: "idx_vendor_products_product_id")
  @@index([status], map: "idx_vendor_products_status")
  @@map("vendor_products")
}

model ProductVariant {
  id                                                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id                                        String             @db.Uuid
  sku                                               String?
  properties                                        Json               @default("{}")
  approval_status                                   String             @default("approved")
  approval_notes                                    String?
  created_by_user_id                                String?            @db.Uuid
  reviewed_by_user_id                               String?            @db.Uuid
  reviewed_at                                       DateTime?          @db.Timestamptz(6)
  is_active                                         Boolean            @default(true)
  created_at                                        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime           @default(now()) @db.Timestamptz(6)
  name                                              String?
  cart_items                                        cart_items[]
  order_items                                       order_items[]
  users_product_variants_created_by_user_idTousers  User?              @relation("product_variants_created_by_user_idTousers", fields: [created_by_user_id], references: [id], onUpdate: NoAction, map: "fk_product_variants_created_by")
  product                                           Product            @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_variants_product")
  users_product_variants_reviewed_by_user_idTousers User?              @relation("product_variants_reviewed_by_user_idTousers", fields: [reviewed_by_user_id], references: [id], onUpdate: NoAction, map: "fk_product_variants_reviewed_by")
  products_images                                   ProductImage[]
  quotationRequests                                 QuotationRequest[]
  vendorProducts                                    VendorProduct[]
  wishlist_items                                    wishlist_items[]

  @@unique([product_id, properties], map: "uq_product_id_properties")
  @@index([approval_status], map: "idx_product_variants_approval_status")
  @@index([product_id], map: "idx_product_variants_product_id")
  @@map("product_variants")
}

model Cart {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String               @db.Uuid
  status             String               @default("active")
  total_amount       Decimal?             @default(0) @db.Decimal(12, 2)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  cart_type          CartType             @default(direct)
  cart_items         cart_items[]
  users              User                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_carts_user")
  orders             Order[]
  service_cart_items service_cart_items[]

  @@unique([user_id, cart_type], map: "idx_carts_user_type_status", where: raw("(status = 'active'::text)"))
  @@map("carts")
}

model QuotationRequest {
  id                                            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                       String             @db.Uuid
  vendor_id                                     String             @db.Uuid
  product_id                                    String             @db.Uuid
  requested_quantity                            Int
  requested_price                               Decimal?           @db.Decimal(12, 2)
  status                                        QuotationStatus    @default(pending_vendor)
  request_note                                  String?
  buyer_city                                    String?
  buyer_state                                   String?
  buyer_country                                 String?
  buyer_pincode                                 String?            @db.VarChar(6)
  current_offer_price                           Decimal?           @db.Decimal(12, 2)
  current_offer_quantity                        Int?
  current_offer_by                              String?
  accepted_price                                Decimal?           @db.Decimal(12, 2)
  accepted_quantity                             Int?
  rejection_reason                              String?
  order_id                                      String?            @db.Uuid
  created_at                                    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime           @default(now()) @db.Timestamptz(6)
  admin_confirmation_status                     String?
  admin_confirmation_message                    String?
  admin_confirmed_at                            DateTime?          @db.Timestamptz(6)
  admin_user_id                                 String?            @db.Uuid
  quotation_group_id                            String?            @db.Uuid
  delivery_days                                 Int?
  token_percentage                              Decimal?           @db.Decimal(5, 2)
  token_amount                                  Decimal?           @db.Decimal(12, 2)
  vendor_document_url                           String?
  vendor_document_s3_key                        String?
  product_variant_id                            String?            @db.Uuid
  payments                                      Payment[]
  messages                                      QuotationMessage[]
  users_quotation_requests_admin_user_idTousers User?              @relation("quotation_requests_admin_user_idTousers", fields: [admin_user_id], references: [id], onUpdate: NoAction, map: "fk_quotation_requests_admin_user")
  order                                         Order?             @relation(fields: [order_id], references: [id], onUpdate: NoAction, map: "fk_quotation_requests_order")
  product                                       Product            @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quotation_requests_product")
  users_quotation_requests_user_idTousers       User               @relation("quotation_requests_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quotation_requests_user")
  variant                                       ProductVariant?    @relation(fields: [product_variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quotation_requests_variant")
  vendor                                        Vendor             @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quotation_requests_vendor")

  @@index([admin_confirmation_status], map: "idx_quotation_requests_admin_status", where: raw("(admin_confirmation_status IS NOT NULL)"))
  @@index([quotation_group_id], map: "idx_quotation_requests_group_id", where: raw("(quotation_group_id IS NOT NULL)"))
  @@index([product_id], map: "idx_quotation_requests_product_id")
  @@index([status], map: "idx_quotation_requests_status")
  @@index([user_id], map: "idx_quotation_requests_user_id")
  @@index([vendor_id], map: "idx_quotation_requests_vendor_id")
  @@map("quotation_requests")
}

model QuotationMessage {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotation_id   String                 @db.Uuid
  sender_user_id String                 @db.Uuid
  sender_role    String
  action         QuotationMessageAction
  offer_price    Decimal?               @db.Decimal(12, 2)
  offer_quantity Int?
  note           String?
  reason         String?
  created_at     DateTime               @default(now()) @db.Timestamptz(6)
  quotation      QuotationRequest       @relation(fields: [quotation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quotation_messages_quotation")
  users          User                   @relation(fields: [sender_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quotation_messages_sender")

  @@index([quotation_id, created_at], map: "idx_quotation_messages_quotation_id")
  @@map("quotation_messages")
}

model Payment {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String            @db.Uuid
  amount               Decimal           @db.Decimal(12, 2)
  currency             String?           @default("INR") @db.VarChar(10)
  status               String?           @default("pending") @db.VarChar(50)
  payment_method       String?           @default("razorpay") @db.VarChar(50)
  razorpay_order_id    String?           @unique @db.VarChar(255)
  razorpay_payment_id  String?           @db.VarChar(255)
  razorpay_signature   String?
  order_ids            String[]          @default([]) @db.Uuid
  quotation_request_id String?           @db.Uuid
  split_number         Int?              @default(1)
  split_percentage     Decimal?          @default(100.00) @db.Decimal(5, 2)
  created_at           DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?         @default(now()) @db.Timestamptz(6)
  booking_ids          String[]          @default([]) @db.Uuid
  quotation_request    QuotationRequest? @relation(fields: [quotation_request_id], references: [id], onUpdate: NoAction)
  user                 User              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([razorpay_order_id], map: "idx_payments_razorpay_order_id")
  @@index([user_id], map: "idx_payments_user_id")
  @@map("payments")
}

model FulfillmentCenter {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                    String                       @unique @db.Uuid
  name                       String
  address                    String
  city                       String
  state                      String
  country                    String
  pincode                    String                       @db.VarChar(6)
  latitude                   Float?
  longitude                  Float?
  capacity                   String?
  is_active                  Boolean                      @default(true)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  code                       String                       @unique
  contact_phone              String?
  contact_email              String?                      @db.Citext
  manager_name               String?
  total_area_sqft            Decimal?                     @db.Decimal(10, 2)
  capacity_packages          Int?
  storage_type               String?
  operating_hours            String?
  status                     String                       @default("active")
  delivery_agents            delivery_agents[]
  users                      User                         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fulfillment_centers_user")
  order_fulfillment_tracking order_fulfillment_tracking[]
  order_route_plan           order_route_plan[]

  @@index([user_id], map: "idx_fulfillment_centers_user_id")
  @@map("fulfillment_centers")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model abandoned_reminder_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  source_type    String
  source_item_id String   @db.Uuid
  reminder_type  String   @default("24h_abandoned_reminder")
  sent_at        DateTime @default(now()) @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  users          User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_abandoned_reminder_logs_user")

  @@unique([source_type, source_item_id, reminder_type], map: "unique_abandoned_reminder_source")
  @@index([source_type, source_item_id], map: "idx_abandoned_reminder_logs_source")
