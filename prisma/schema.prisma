  assigned_agent_id         String?                     @db.Uuid
  asset_id                  String?                     @db.Uuid
  status                    String                      @default("draft") @db.VarChar(30)
  priority                  String                      @default("medium") @db.VarChar(20)
  ticket_payload            Json                        @default("{}")
  quotation_breakdown       Json                        @default("{}")
  total_amount              Decimal?                    @default(0.00) @db.Decimal(12, 2)
  advance_paid              Decimal?                    @default(0.00) @db.Decimal(12, 2)
  completion_otp            String?                     @db.VarChar(6)
  otp_verified_at           DateTime?                   @db.Timestamptz(6)
  timeline_logs             Json                        @default("[]")
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  product_category          product_category            @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  subcategories             subcategories?              @relation(fields: [subcategory_id], references: [id], onUpdate: NoAction)
  client_user               User                        @relation("service_tickets_client", fields: [client_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assigned_agent            User?                       @relation("service_tickets_agent", fields: [assigned_agent_id], references: [id], onUpdate: NoAction)
  vendors                   Vendor?                     @relation(fields: [vendor_id], references: [id], onUpdate: NoAction)
  client_asset              client_assets?              @relation(fields: [asset_id], references: [id], onUpdate: NoAction)
  service_ticket_quotations service_ticket_quotations[]
  service_ticket_documents  service_ticket_documents[]

  @@index([client_user_id], map: "idx_srv_tickets_client")
  @@index([vendor_id], map: "idx_srv_tickets_vendor")
  @@index([status], map: "idx_srv_tickets_status")
  @@index([category_id], map: "idx_srv_tickets_cat")
}

model service_ticket_quotations {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id        String          @db.Uuid
  vendor_id        String          @db.Uuid
  status           String          @default("submitted") @db.VarChar(20)
  quote_breakdown  Json            @default("{}")
  total_price      Decimal         @db.Decimal(12, 2)
  token_percentage Decimal?        @default(0.00) @db.Decimal(5, 2)
  token_amount     Decimal?        @default(0.00) @db.Decimal(12, 2)
  valid_until      DateTime?       @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  service_tickets  service_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendors          Vendor          @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticket_id], map: "idx_srv_ticket_quotes_ticket")
  @@index([vendor_id], map: "idx_srv_ticket_quotes_vendor")
}

model service_ticket_documents {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id           String          @db.Uuid
  doc_type            String          @db.VarChar(50)
  doc_name            String?
  doc_url             String
  uploaded_by_user_id String?         @db.Uuid
  metadata            Json            @default("{}")
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  service_tickets     service_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploaded_by_user    User?           @relation("service_ticket_documents_uploaded_by", fields: [uploaded_by_user_id], references: [id], onUpdate: NoAction)

  @@index([ticket_id], map: "idx_srv_ticket_docs_ticket")
}

model contact_queries {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  company    String?
  phone      String?
  subject    String
  message    String
  status     String   @default("new")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([status], map: "idx_contact_queries_status")
  @@index([created_at(sort: Desc)], map: "idx_contact_queries_created_at")
}